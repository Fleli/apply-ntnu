# Lokal SQLite-fil er standard og trenger ingen oppsett.
# For hosting: pek på en Turso-database (libsql://...) og legg inn token.
DATABASE_URL=file:./data/apply.db
DATABASE_AUTH_TOKEN=
# Vercels Turso-integrasjon setter TURSO_DATABASE_URL og TURSO_AUTH_TOKEN.
# Disse brukes når DATABASE_URL/DATABASE_AUTH_TOKEN ikke er satt.
# Ikke sett den lokale file:-adressen på hosting.

# På hosting: stabil tilfeldig hemmelighet, minst 32 tegn (f.eks. openssl rand -base64 32).
BETTER_AUTH_SECRET=
# Offentlig origin, uten sti; bruk den faktiske HTTPS-adressen på hosting.
BETTER_AUTH_URL=http://localhost:3000
